<Window x:Class="Mos.Recorder.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="4B — دستیار ویزیت" Width="800" Height="800" MinWidth="640" MinHeight="640" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="15" Background="#F4F6FA" Closing="WindowClosing">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<Border Background="#112943" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="4B | دستیار ویزیت ویندوز" Foreground="White" FontSize="26" FontWeight="Bold"/><TextBlock Foreground="#E9CC85" Text="نسخه آزمایشی ۰٫۳ — ضبط امن، مرور متن و گزارش اصلاحات"/></StackPanel></Border>
<StackPanel x:Name="LoginPanel" Margin="0,20,0,0">
<TextBlock Text="آدرس سرور MOS"/><TextBox x:Name="ServerBox" Text="https://mos.example.com/" FlowDirection="LeftToRight"/>
<TextBlock Text="نام کاربری پزشک"/><TextBox x:Name="UsernameBox" FlowDirection="LeftToRight"/>
<TextBlock Text="رمز عبور"/><PasswordBox x:Name="PasswordBox" Padding="8" Margin="0,4,0,10"/>
<Button x:Name="LoginButton" Content="ورود" Click="LoginClick" HorizontalAlignment="Left"/>
</StackPanel>
<StackPanel x:Name="VisitPanel" Visibility="Collapsed" Margin="0,18,0,0">
<DockPanel><Button x:Name="LogoutButton" Content="خروج" Click="LogoutClick" DockPanel.Dock="Left"/><TextBlock x:Name="IdentityText" VerticalAlignment="Center"/></DockPanel>
<TextBlock Text="شناسه ویزیت"/><TextBox x:Name="VisitBox" FlowDirection="LeftToRight"/>
<Button x:Name="LoadButton" Content="بررسی ویزیت و رضایت ضبط" Click="LoadClick" HorizontalAlignment="Left"/>
<TextBlock x:Name="VisitText" Margin="0,10"/>
<TextBlock Text="میکروفن"/><ComboBox x:Name="Microphones" Margin="0,6,0,10"/>
<CheckBox x:Name="AcknowledgeBox" Content="بیمار و ویزیت صحیح را بررسی کرده‌ام و بیمار از شروع ضبط مطلع است." Margin="0,8"/>
<WrapPanel><Button x:Name="StartButton" Content="شروع ضبط" Click="StartClick" IsEnabled="False"/><Button x:Name="StopButton" Content="توقف و نگهداری امن" Click="StopClick" IsEnabled="False"/></WrapPanel>
<ProgressBar x:Name="LevelBar" Minimum="0" Maximum="100" Height="12" Margin="0,10"/><TextBlock x:Name="CaptureText"/>
<Button x:Name="SyncButton" Content="ثبت پایان ضبط‌های معلق در MOS" Click="SyncClick" HorizontalAlignment="Left" Margin="0,12"/>
<TextBlock Text="صوت محلی رمزگذاری می‌شود. انتقال به MOS فقط با اقدام شما و رضایت معتبر انجام می‌شود. متن ماشینی پیش‌نویس است و نیاز به اصلاح پزشک دارد." Foreground="#5A6473" Margin="0,12"/>
<Separator Margin="0,16"/>
<TextBlock Text="ضبط‌های تکمیل‌شده این حساب" FontWeight="Bold"/>
<ComboBox x:Name="RecordingsBox" DisplayMemberPath="Label" Margin="0,8" SelectionChanged="RecordingSelectionChanged"/>
<WrapPanel><Button x:Name="UploadButton" Content="انتقال امن صوت به MOS" Click="UploadClick"/><Button x:Name="TranscribeButton" Content="درخواست تبدیل گفتار" Click="TranscribeClick"/><Button x:Name="TextLoadButton" Content="دریافت وضعیت و متن" Click="TextLoadClick"/></WrapPanel>
<TextBlock x:Name="MediaStateText" Margin="0,8"/>
<TextBlock Text="پیش‌نویس ماشینی — هویت گویندگان مشخص نشده است"/>
<TextBox x:Name="DraftBox" IsReadOnly="True" AcceptsReturn="True" Height="140" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
<TextBlock Text="متن اصلاح‌شده پزشک"/>
<TextBox x:Name="ReviewBox" AcceptsReturn="True" Height="180" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
<CheckBox x:Name="ReviewCheck" Content="متن را با گفتگوی ویزیت تطبیق داده‌ام و اصلاحات لازم را انجام داده‌ام." Margin="0,8"/>
<Button x:Name="ReviewButton" Content="ثبت متن مرورشده در MOS" Click="ReviewClick" HorizontalAlignment="Left"/>
<Button x:Name="MetricsButton" Content="نمایش گزارش اختلاف متن ثبت‌شده" Click="MetricsClick" HorizontalAlignment="Left" Margin="0,10" IsEnabled="False"/>
<Border x:Name="MetricsPanel" Visibility="Collapsed" Background="#FFF8E9" CornerRadius="8" Padding="16" Margin="0,8">
<StackPanel><TextBlock Text="گزارش آخرین متن ثبت‌شده پزشک و پیش‌نویس متناظر" FontWeight="Bold" TextWrapping="Wrap"/>
<TextBlock x:Name="MetricsText" Margin="0,10" TextWrapping="Wrap"/>
<TextBlock Text="این اعداد میزان اختلاف نوشتاری را نشان می‌دهند؛ دقت بالینی گفتار نیستند. صفر بودن اختلاف، جای تطبیق با صوت را نمی‌گیرد. تغییر عدد را با گفتگوی ویزیت بررسی کنید." TextWrapping="Wrap" Foreground="#72531D"/>
</StackPanel></Border>
<TextBlock Text="این مرحله تشخیص خودکار یا آموزش مدل ایجاد نمی‌کند. متن تأییدشده جدا از پیش‌نویس نگهداری می‌شود." Foreground="#5A6473" Margin="0,8"/>
</StackPanel>
<Border Background="White" Padding="16" CornerRadius="8" Margin="0,20"><TextBlock x:Name="StatusText" Text="برای شروع، سرور کلینیک و حساب پزشک را وارد کنید." AutomationProperties.LiveSetting="Polite"/></Border>
</StackPanel></ScrollViewer></Window>