    "StructuredAnswer": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "chief_complaint",
            "onset",
            "duration",
            "pain_location",
            "pain_score",
            "pain_pattern",
            "aggravating_factor",
            "relieving_factor",
            "mechanical_locking",
            "functional_limitation",
            "trauma",
            "trauma_mechanism",
            "prior_surgery",
            "prior_treatment",
            "treatment_response",
            "relevant_comorbidity",
            "current_medication",
            "fever",
            "acute_swelling",
            "neurovascular_symptoms",
            "systemic_symptoms",
            "care_goal",
            "exam_joint_line_tenderness",
            "exam_effusion",
            "exam_range_of_motion",
            "imaging_kl_grade",
            "imaging_meniscal_lesion",
            "imaging_cartilage_lesion"
