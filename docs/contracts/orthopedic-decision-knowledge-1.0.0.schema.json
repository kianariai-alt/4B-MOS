{
  "$defs": {
    "AssessmentRequirement": {
      "additionalProperties": false,
      "properties": {
        "differential_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Differential Id",
          "type": "string"
        },
        "requirements": {
          "items": {
            "type": "string"
          },
          "title": "Requirements",
          "type": "array"
        },
        "fact_keys": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "title": "Fact Keys",
          "type": "array"
        },
        "governance_status": {
          "const": "draft",
          "default": "draft",
          "title": "Governance Status",
          "type": "string"
        },
        "is_order": {
          "const": false,
          "default": false,
          "title": "Is Order",
          "type": "boolean"
        }
      },
      "required": [
        "differential_id",
        "requirements",
        "fact_keys"
      ],
      "title": "AssessmentRequirement",
      "type": "object"
    },
    "DifferentialDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "known_presentations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Known Presentations",
          "type": "array"
        },
        "risk_factors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Risk Factors",
          "type": "array"
        },
        "supporting_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Findings",
          "type": "array"
        },
        "opposing_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Opposing Findings",
          "type": "array"
        },
        "examination_ids": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "title": "Examination Ids",
          "type": "array"
        },
        "assessment_requirements": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Assessment Requirements",
          "type": "array"
        },
        "warning_features": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warning Features",
          "type": "array"
        },
        "diagnostic_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Diagnostic Criteria",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "fact_keys": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Keys",
          "type": "array"
        },
        "status": {
          "const": "draft",
          "default": "draft",
          "title": "Status",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "known_presentations",
        "assessment_requirements",
        "limitations",
        "fact_keys"
      ],
      "title": "DifferentialDefinition",
      "type": "object"
    },
    "DifferentialKnowledgeReference": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/DifferentialDefinition"
        },
        "compatibility": {
          "const": "not_assessed",
          "default": "not_assessed",
          "title": "Compatibility",
          "type": "string"
        },
        "is_ranked": {
          "const": false,
          "default": false,
          "title": "Is Ranked",
          "type": "boolean"
        }
      },
      "required": [
        "definition"
      ],
      "title": "DifferentialKnowledgeReference",
      "type": "object"
    },
    "InformationGap": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "chief_complaint",
            "onset",
            "duration",
            "pain_location",
            "pain_score",
            "pain_pattern",
            "aggravating_factor",
            "relieving_factor",
            "mechanical_locking",
            "functional_limitation",
            "trauma",
            "trauma_mechanism",
            "prior_surgery",
            "prior_treatment",
            "treatment_response",
            "relevant_comorbidity",
            "current_medication",
            "fever",
            "acute_swelling",
            "neurovascular_symptoms",
            "systemic_symptoms",
            "care_goal",
            "exam_joint_line_tenderness",
            "exam_effusion",
            "exam_range_of_motion",
            "imaging_kl_grade",
            "imaging_meniscal_lesion",
            "imaging_cartilage_lesion"
          ],
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "enum": [
            "missing",
            "unknown",
            "declined",
            "unverified",
            "incomplete",
            "contradictory"
          ],
          "title": "Reason",
          "type": "string"
        },
        "requires_physician_review": {
          "title": "Requires Physician Review",
          "type": "boolean"
        }
      },
      "required": [
        "field",
        "reason",
        "requires_physician_review"
      ],
      "title": "InformationGap",
      "type": "object"
    },
    "InterviewQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "text_fa": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Text Fa",
          "type": "string"
        },
        "purpose_fa": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Purpose Fa",
          "type": "string"
        },
        "answer_type": {
          "default": "text",
          "enum": [
            "text",
            "yes_no",
            "single_choice"
          ],
          "title": "Answer Type",
          "type": "string"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Choices",
          "type": "array"
        },
        "depends_on_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depends On Id"
        },
        "show_when_answer_in": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Show When Answer In",
          "type": "array"
        },
        "allow_unknown": {
          "const": true,
          "default": true,
          "title": "Allow Unknown",
          "type": "boolean"
        },
        "allow_decline": {
          "const": true,
          "default": true,
          "title": "Allow Decline",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text_fa",
        "purpose_fa"
      ],
      "title": "InterviewQuestion",
      "type": "object"
    },
    "OrthopedicEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "fact_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Fact Key",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "content_hash_scope": {
          "const": "registry_fact_content_with_metadata",
          "default": "registry_fact_content_with_metadata",
          "title": "Content Hash Scope",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "population": {
          "title": "Population",
          "type": "string"
        },
        "application_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Application Conditions",
          "type": "array"
        },
        "evidence_grade": {
          "title": "Evidence Grade",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "source_keys": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Keys",
          "type": "array"
        },
        "governance_status": {
          "const": "draft",
          "default": "draft",
          "title": "Governance Status",
          "type": "string"
        },
        "approved_content_sha256": {
          "default": null,
          "title": "Approved Content Sha256",
          "type": "null"
        },
        "usable_as_approved_knowledge": {
          "const": false,
          "default": false,
          "title": "Usable As Approved Knowledge",
          "type": "boolean"
        }
      },
      "required": [
        "fact_key",
        "version",
        "content_sha256",
        "statement",
        "population",
        "application_conditions",
        "evidence_grade",
        "limitations",
        "source_keys"
      ],
      "title": "OrthopedicEvidenceReference",
      "type": "object"
    },
    "OrthopedicSourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doi"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Version"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "hash_scope": {
          "const": "source_reference_metadata",
          "default": "source_reference_metadata",
          "title": "Hash Scope",
          "type": "string"
        },
        "access_level": {
          "title": "Access Level",
          "type": "string"
        },
        "verification_note": {
          "title": "Verification Note",
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "title",
        "url",
        "doi",
        "source_version",
        "source_sha256",
        "access_level",
        "verification_note"
      ],
      "title": "OrthopedicSourceReference",
      "type": "object"
    },
    "QuestionCandidate": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "$ref": "#/$defs/InterviewQuestion"
        },
        "field": {
          "enum": [
            "chief_complaint",
            "onset",
            "duration",
            "pain_location",
            "pain_score",
            "pain_pattern",
            "aggravating_factor",
            "relieving_factor",
            "mechanical_locking",
            "functional_limitation",
            "trauma",
            "trauma_mechanism",
            "prior_surgery",
            "prior_treatment",
            "treatment_response",
            "relevant_comorbidity",
            "current_medication",
            "fever",
            "acute_swelling",
            "neurovascular_symptoms",
            "systemic_symptoms",
            "care_goal",
            "exam_joint_line_tenderness",
            "exam_effusion",
            "exam_range_of_motion",
            "imaging_kl_grade",
            "imaging_meniscal_lesion",
            "imaging_cartilage_lesion"
