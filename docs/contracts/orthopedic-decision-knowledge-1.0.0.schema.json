        "state": {
          "enum": [
            "confirmed",
            "unverified",
            "incomplete",
            "contradictory",
            "unknown",
            "declined"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
