{
  "$defs": {
    "AssessmentConsideration": {
      "additionalProperties": false,
      "properties": {
        "governance_status": {
          "const": "draft",
          "default": "draft",
          "title": "Governance Status",
          "type": "string"
        },
        "source_binding_status": {
          "const": "draft_authored",
          "default": "draft_authored",
          "title": "Source Binding Status",
          "type": "string"
        },
        "requires_independent_review": {
          "const": true,
          "default": true,
          "title": "Requires Independent Review",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label_fa": {
          "title": "Label Fa",
          "type": "string"
        },
        "supporting_findings_fa": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Findings Fa",
          "type": "array"
        },
        "limitations_fa": {
          "items": {
            "type": "string"
          },
          "title": "Limitations Fa",
          "type": "array"
        },
        "information_gaps_fa": {
          "items": {
            "type": "string"
          },
          "title": "Information Gaps Fa",
          "type": "array"
        },
        "assessment_requirements_fa": {
          "items": {
            "type": "string"
          },
          "title": "Assessment Requirements Fa",
          "type": "array"
        },
        "source_fact_keys": {
          "items": {
            "type": "string"
          },
          "title": "Source Fact Keys",
          "type": "array"
        },
        "source_content_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Content Sha256S",
          "type": "array"
        },
        "source_keys": {
          "items": {
            "type": "string"
          },
          "title": "Source Keys",
          "type": "array"
        },
        "is_ranked": {
          "const": false,
          "default": false,
          "title": "Is Ranked",
          "type": "boolean"
        },
        "compatibility": {
          "enum": [
            "authored_pattern_for_review",
            "documented_finding_for_review",
            "urgent_context_for_review"
          ],
          "title": "Compatibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label_fa",
        "supporting_findings_fa",
        "limitations_fa",
        "information_gaps_fa",
        "assessment_requirements_fa",
        "source_fact_keys",
        "source_content_sha256s",
        "source_keys",
        "compatibility"
      ],
      "title": "AssessmentConsideration",
      "type": "object"
    },
    "AssessmentDraftProposal": {
      "additionalProperties": false,
      "properties": {
        "governance_status": {
          "const": "draft",
          "default": "draft",
          "title": "Governance Status",
          "type": "string"
        },
        "source_binding_status": {
          "const": "draft_authored",
          "default": "draft_authored",
          "title": "Source Binding Status",
          "type": "string"
        },
        "requires_independent_review": {
          "const": true,
          "default": true,
          "title": "Requires Independent Review",
          "type": "boolean"
        },
        "fact": {
          "$ref": "#/$defs/KnowledgeFactCreate"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "fact",
        "content_sha256"
      ],
      "title": "AssessmentDraftProposal",
      "type": "object"
    },
    "ConditionalTreatmentEvidence": {
      "additionalProperties": false,
      "properties": {
        "governance_status": {
          "const": "draft",
          "default": "draft",
          "title": "Governance Status",
          "type": "string"
        },
        "source_binding_status": {
          "const": "draft_authored",
          "default": "draft_authored",
          "title": "Source Binding Status",
          "type": "string"
        },
        "requires_independent_review": {
          "const": true,
          "default": true,
          "title": "Requires Independent Review",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label_fa": {
          "title": "Label Fa",
          "type": "string"
        },
        "summary_fa": {
          "title": "Summary Fa",
          "type": "string"
        },
        "conditions_fa": {
          "items": {
            "type": "string"
          },
          "title": "Conditions Fa",
          "type": "array"
        },
        "limitations_fa": {
          "items": {
            "type": "string"
          },
          "title": "Limitations Fa",
          "type": "array"
        },
        "source_fact_keys": {
          "items": {
            "type": "string"
          },
          "title": "Source Fact Keys",
          "type": "array"
        },
        "source_content_sha256s": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Content Sha256S",
          "type": "array"
        },
        "source_keys": {
          "items": {
            "type": "string"
          },
          "title": "Source Keys",
          "type": "array"
        },
        "requires_card_id": {
          "default": "knee_oa",
          "title": "Requires Card Id",
          "type": "string"
        },
        "required_workflow_status": {
          "const": "ready",
          "default": "ready",
          "title": "Required Workflow Status",
          "type": "string"
        },
        "is_personalized_plan": {
          "const": false,
          "default": false,
          "title": "Is Personalized Plan",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label_fa",
        "summary_fa",
        "conditions_fa",
        "limitations_fa",
        "source_fact_keys",
        "source_content_sha256s",
        "source_keys"
      ],
      "title": "ConditionalTreatmentEvidence",
      "type": "object"
    },
    "KnowledgeFactCreate": {
      "properties": {
        "title": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 20,
          "title": "Statement",
          "type": "string"
        },
        "clinical_domain": {
          "maxLength": 100,
          "minLength": 2,
          "title": "Clinical Domain",
          "type": "string"
        },
        "therapy_type": {
          "anyOf": [
            {
              "enum": [
                "PRP",
                "PRGF",
                "ACS",
                "PL",
                "SVF",
                "EXOSOME",
                "MSC"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Therapy Type"
        },
        "population": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Population"
        },
        "indication": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indication"
        },
        "contraindications": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Contraindications",
          "type": "array"
        },
        "evidence_grade": {
          "enum": [
            "high",
            "moderate",
            "low",
            "very_low",
            "consensus",
            "ungraded"
          ],
          "title": "Evidence Grade",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/KnowledgeSourceCreate"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "fact_key": {
          "maxLength": 100,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Fact Key",
          "type": "string"
        }
      },
      "required": [
        "title",
        "statement",
        "clinical_domain",
        "evidence_grade",
        "sources",
        "fact_key"
      ],
      "title": "KnowledgeFactCreate",
      "type": "object"
    },
    "KnowledgeSourceCreate": {
      "properties": {
        "source_type": {
          "enum": [
            "guideline",
            "systematic_review",
            "randomized_trial",
            "observational_study",
            "regulatory",
            "consensus",
            "textbook",
            "other"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "citation": {
          "maxLength": 5000,
          "minLength": 3,
          "title": "Citation",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "doi": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "publication_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Date"
        },
        "guideline_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guideline Version"
        },
        "accessed_at": {
          "format": "date",
          "title": "Accessed At",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "title",
        "citation"
      ],
      "title": "KnowledgeSourceCreate",
      "type": "object"
    },
    "SourceEntry": {
      "additionalProperties": false,
      "properties": {
        "source_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/KnowledgeSourceCreate"
        },
        "verified_at": {
          "format": "date",
          "title": "Verified At",
          "type": "string"
        },
        "access_level": {
          "enum": [
            "full_text",
            "abstract",
            "bibliographic_metadata",
            "indexed_recommendations"
          ],
          "title": "Access Level",
          "type": "string"
        },
        "verification_note": {
          "minLength": 10,
          "title": "Verification Note",
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "source",
        "verified_at",
        "access_level",
        "verification_note"
      ],
      "title": "SourceEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "governance_status": {
      "const": "draft",
      "default": "draft",
      "title": "Governance Status",
      "type": "string"
    },
    "source_binding_status": {
      "const": "draft_authored",
      "default": "draft_authored",
      "title": "Source Binding Status",
      "type": "string"
    },
    "requires_independent_review": {
      "const": true,
      "default": true,
      "title": "Requires Independent Review",
      "type": "boolean"
    },
    "schema_id": {
      "const": "4b-mos.knee-assessment-preview",
      "default": "4b-mos.knee-assessment-preview",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "differential_review",
        "insufficient_information",
        "prompt_physician_review",
        "outside_scope",
        "side_specific_review"
      ],
      "title": "Status",
      "type": "string"
    },
    "headline_fa": {
      "title": "Headline Fa",
      "type": "string"
    },
    "considerations": {
      "items": {
        "$ref": "#/$defs/AssessmentConsideration"
      },
      "title": "Considerations",
      "type": "array"
    },
    "urgent_considerations": {
      "items": {
        "$ref": "#/$defs/AssessmentConsideration"
      },
      "title": "Urgent Considerations",
      "type": "array"
    },
    "information_requirements_fa": {
      "items": {
        "type": "string"
      },
      "title": "Information Requirements Fa",
      "type": "array"
    },
    "conditional_treatment_evidence": {
      "items": {
        "$ref": "#/$defs/ConditionalTreatmentEvidence"
      },
      "title": "Conditional Treatment Evidence",
      "type": "array"
    },
    "review_reasons_fa": {
      "items": {
        "type": "string"
      },
      "title": "Review Reasons Fa",
      "type": "array"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceEntry"
      },
      "title": "Source References",
      "type": "array"
    },
    "new_draft_proposals": {
      "items": {
        "$ref": "#/$defs/AssessmentDraftProposal"
      },
      "title": "New Draft Proposals",
      "type": "array"
    },
    "axis_tokens": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Axis Tokens",
      "type": "object"
    },
    "lookup_model_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Lookup Model Sha256",
      "type": "string"
    },
    "preview_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preview Sha256",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "rules_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rules Sha256",
      "type": "string"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "approved_fact_count": {
      "const": 0,
      "default": 0,
      "title": "Approved Fact Count",
      "type": "integer"
    },
    "review_only": {
      "const": true,
      "default": true,
      "title": "Review Only",
      "type": "boolean"
    },
    "is_diagnosis": {
      "const": false,
      "default": false,
      "title": "Is Diagnosis",
      "type": "boolean"
    },
    "is_recommendation": {
      "const": false,
      "default": false,
      "title": "Is Recommendation",
      "type": "boolean"
    },
    "is_clinical_clearance": {
      "const": false,
      "default": false,
      "title": "Is Clinical Clearance",
      "type": "boolean"
    },
    "authorizes_treatment": {
      "const": false,
      "default": false,
      "title": "Authorizes Treatment",
      "type": "boolean"
    },
    "registry_write_performed": {
      "const": false,
      "default": false,
      "title": "Registry Write Performed",
      "type": "boolean"
    },
    "safety_engine_required": {
      "const": true,
      "default": true,
      "title": "Safety Engine Required",
      "type": "boolean"
    },
    "safety_evaluation": {
      "const": "not_performed",
      "default": "not_performed",
      "title": "Safety Evaluation",
      "type": "string"
    }
  },
  "required": [
    "status",
    "headline_fa",
    "considerations",
    "urgent_considerations",
    "information_requirements_fa",
    "conditional_treatment_evidence",
    "review_reasons_fa",
    "source_references",
    "new_draft_proposals",
    "axis_tokens",
    "lookup_model_sha256",
    "preview_sha256",
    "request_sha256",
    "rules_sha256",
    "result_sha256"
  ],
  "title": "KneeAssessmentPreview",
  "type": "object"
}
