{
  "$defs": {
    "StructuredAnswer": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "chief_complaint",
            "onset",
            "duration",
            "pain_location",
            "pain_score",
            "pain_pattern",
            "aggravating_factor",
            "relieving_factor",
            "mechanical_locking",
            "functional_limitation",
            "trauma",
            "trauma_mechanism",
            "prior_surgery",
            "prior_treatment",
            "treatment_response",
            "relevant_comorbidity",
            "current_medication",
            "fever",
            "acute_swelling",
            "neurovascular_symptoms",
            "systemic_symptoms",
            "care_goal",
            "exam_joint_line_tenderness",
            "exam_effusion",
            "exam_range_of_motion",
            "imaging_kl_grade",
            "imaging_meniscal_lesion",
            "imaging_cartilage_lesion"
          ],
          "title": "Field",
          "type": "string"
        },
        "state": {
          "enum": [
            "confirmed",
            "unverified",
            "incomplete",
            "contradictory",
            "unknown",
            "declined"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "provenance": {
          "enum": [
            "patient_report",
            "physician_exam",
            "reviewed_imaging",
            "unreviewed_imaging"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "source_ref": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "field",
        "state",
        "provenance",
        "source_ref"
      ],
      "title": "StructuredAnswer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "body_region": {
      "default": "unknown",
      "enum": [
        "knee",
        "other",
        "unknown"
      ],
      "title": "Body Region",
      "type": "string"
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StructuredAnswer"
      },
      "maxItems": 200,
      "title": "Observations",
      "type": "array"
    }
  },
  "title": "OrthopedicQuestionContext",
  "type": "object"
}
