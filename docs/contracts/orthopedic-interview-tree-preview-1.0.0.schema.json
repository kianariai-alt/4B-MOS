{
  "$defs": {
    "BankContent": {
      "additionalProperties": false,
      "properties": {
        "title_fa": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Title Fa",
          "type": "string"
        },
        "scope_fa": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Scope Fa",
          "type": "string"
        },
        "summary_preferences_fa": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary Preferences Fa"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/InterviewQuestion"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "title_fa",
        "scope_fa",
        "questions"
      ],
      "title": "BankContent",
      "type": "object"
    },
    "BookDraftPageProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        },
        "pdf_page_number": {
          "exclusiveMinimum": 0,
          "title": "Pdf Page Number",
          "type": "integer"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_file_sha256",
        "pdf_page_number",
        "text_sha256"
      ],
      "title": "BookDraftPageProvenance",
      "type": "object"
    },
    "BookDraftProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "const": "4b-mos.book-draft-provenance",
          "default": "4b-mos.book-draft-provenance",
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "extraction_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Extraction Manifest Sha256",
          "type": "string"
        },
        "verifier_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verifier Artifact Sha256",
          "type": "string"
        },
        "handoff_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Handoff Sha256",
          "type": "string"
        },
        "source_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "pages_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pages Artifact Sha256",
          "type": "string"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/BookDraftPageProvenance"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "chapter": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Chapter",
          "type": "string"
        },
        "reported_printed_pages": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Printed Pages"
        },
        "printed_page_verification": {
          "const": "unverified",
          "default": "unverified",
          "title": "Printed Page Verification",
          "type": "string"
        },
        "proposal_origin": {
          "enum": [
            "human_authored",
            "ai_assisted_draft"
          ],
          "title": "Proposal Origin",
          "type": "string"
        },
        "source_pdf_verification_scope": {
          "const": "technical_bytes_only",
          "default": "technical_bytes_only",
          "title": "Source Pdf Verification Scope",
          "type": "string"
        },
        "bibliographic_identity_review": {
          "const": "pending",
          "default": "pending",
          "title": "Bibliographic Identity Review",
          "type": "string"
        },
        "clinical_source_review": {
          "const": "pending",
          "default": "pending",
          "title": "Clinical Source Review",
          "type": "string"
        },
        "source_entailment_review": {
          "const": "pending",
          "default": "pending",
          "title": "Source Entailment Review",
          "type": "string"
        },
        "requires_independent_review": {
          "const": true,
          "default": true,
          "title": "Requires Independent Review",
          "type": "boolean"
        }
      },
      "required": [
        "extraction_manifest_sha256",
        "verifier_artifact_sha256",
        "handoff_sha256",
        "source_file_sha256",
        "filename",
        "pages_artifact_sha256",
        "pages",
        "chapter",
        "proposal_origin"
      ],
      "title": "BookDraftProvenance",
      "type": "object"
    },
    "BookQuestionSourceReference": {
      "additionalProperties": false,
      "properties": {
        "governance_status": {
          "const": "draft",
          "default": "draft",
          "title": "Governance Status",
          "type": "string"
        },
        "requires_independent_review": {
          "const": true,
          "default": true,
          "title": "Requires Independent Review",
          "type": "boolean"
        },
        "population_applicability": {
          "const": "not_assessed",
          "default": "not_assessed",
          "title": "Population Applicability",
          "type": "string"
        },
        "candidate_key": {
          "maxLength": 100,
          "minLength": 3,
          "title": "Candidate Key",
          "type": "string"
        },
        "registry_fact_key": {
          "maxLength": 100,
          "minLength": 3,
          "title": "Registry Fact Key",
          "type": "string"
        },
        "action": {
          "enum": [
            "new_fact",
            "support_existing"
          ],
          "title": "Action",
          "type": "string"
        },
        "title": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "population": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Population",
          "type": "string"
        },
        "indication": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Indication",
          "type": "string"
        },
        "application_conditions": {
          "items": {
            "maxLength": 5000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Application Conditions",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 5000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "evidence_scope": {
          "enum": [
            "clinical_assessment",
            "structural_assessment",
            "proposed_mechanism",
            "historical_evidence_summary"
          ],
          "title": "Evidence Scope",
          "type": "string"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "entry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Entry Sha256",
          "type": "string"
        },
        "support_scope": {
          "anyOf": [
            {
              "const": "location_component_only",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Scope"
        },
        "target_base_fact_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Base Fact Content Sha256"
        },
        "source": {
          "$ref": "#/$defs/KnowledgeSourceCreate"
        },
        "provenance": {
          "$ref": "#/$defs/BookDraftProvenance"
        }
      },
      "required": [
        "candidate_key",
        "registry_fact_key",
        "action",
        "title",
        "summary",
        "population",
        "indication",
        "application_conditions",
        "limitations",
        "evidence_scope",
        "entry_sha256",
        "source",
        "provenance"
      ],
      "title": "BookQuestionSourceReference",
      "type": "object"
    },
    "InterviewQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Id",
          "type": "string"
        },
        "text_fa": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Text Fa",
          "type": "string"
