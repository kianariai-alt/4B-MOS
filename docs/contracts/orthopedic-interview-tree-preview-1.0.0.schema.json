        "purpose_fa": {
          "maxLength": 1000,
          "minLength": 3,
          "title": "Purpose Fa",
          "type": "string"
        },
        "answer_type": {
          "default": "text",
          "enum": [
            "text",
            "yes_no",
            "single_choice"
          ],
          "title": "Answer Type",
          "type": "string"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Choices",
          "type": "array"
        },
        "depends_on_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depends On Id"
        },
        "show_when_answer_in": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Show When Answer In",
          "type": "array"
        },
        "allow_unknown": {
          "const": true,
          "default": true,
          "title": "Allow Unknown",
          "type": "boolean"
        },
        "allow_decline": {
          "const": true,
          "default": true,
          "title": "Allow Decline",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text_fa",
        "purpose_fa"
      ],
      "title": "InterviewQuestion",
      "type": "object"
    },
