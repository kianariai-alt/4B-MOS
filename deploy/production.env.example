# Template only. Do not deploy until backups, HTTPS and access controls pass review.
# The read-only release preflight consumes the same reviewed private values:
#   python -m backend.tools.release_preflight
ENVIRONMENT=production
DEBUG=false
BOOTSTRAP_ENABLED=false
# Generate locally and keep private. This placeholder is deliberately rejected.
SECRET_KEY=change-this-to-a-separately-generated-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Persistent, account-bound login protection. Review together; values are
# bounded by application validation and do not replace edge/source throttling.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=300
HOST=127.0.0.1
PORT=8000
# Replace with the reviewed, explicit location. Never point rehearsals at production.
DATABASE_URL=sqlite:///./4bmos.db
# PostgreSQL only: fail bounded lock waits so callers can reload and retry.
DATABASE_LOCK_TIMEOUT_MS=5000
CLINIC_TIMEZONE=Asia/Tehran
